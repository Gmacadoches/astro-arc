# Runs astro-arc-generate.service every 15 minutes. Persistent=true means
# a period boundary crossed while the machine was asleep/off (very plausible
# for a laptop overnight) still fires the service shortly after the next
# boot/login, instead of waiting for the next on-the-quarter-hour mark.
[Unit]
Description=Periodically check whether Astro-Arc is due for a new generation

[Timer]
OnCalendar=*:0/15
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
