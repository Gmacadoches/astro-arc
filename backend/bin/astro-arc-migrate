#!/usr/bin/env python3
"""Brings an install made with install.sh onto the zero-install layout.

Until 2026-09-19 Astro-Arc had an installer that wrote things outside the
plugin: a systemd timer, an astroarc:// URL handler, and an archive kept under
~/.local/state. None of that exists any more, and Omarchy removes a plugin by
deleting its folder, so leftovers would outlive it — the timer would try to run
a deleted script every fifteen minutes, forever. This undoes all of it, once,
with nothing for the user to run:

  1. stops and removes the systemd timer and service
  2. removes the astroarc:// handler and its URL-scheme registration
  3. moves the archive from ~/.local/state/omarchy/astro-arc/reviews to
     ~/.local/share/astro-arc (see paths.py for why), adds the thumbnails and
     text the gallery needs, points each old page's Save Theme button at the
     panel instead of the removed handler, and writes the gallery

It touches only files Astro-Arc itself created, runs from both the panel (when
the shell starts) and astro-arc-generate, is safe to run any number of times,
and prints nothing when there is nothing to do. The old Python venv under
~/.local/share/omarchy/astro-arc is left alone — it may hold things the user
installed into it — and the README says it can be deleted.
"""

import base64
import fcntl
import html
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import archive_gallery  # noqa: E402
from image_fit import ImageError, thumbnail_jpeg  # noqa: E402
from paths import ARCHIVE_DIR, GENERATIONS_DIR, GENERATIONS_INDEX, LEGACY_REVIEWS_DIR, STATE_DIR  # noqa: E402

HOME = Path.home()
SYSTEMD_DIR = HOME / ".config/systemd/user"
UNITS = ("astro-arc-generate.timer", "astro-arc-generate.service")
HANDLER = HOME / ".local/share/applications/astro-arc-save-theme-handler.desktop"
MIMEAPPS = (HOME / ".config/mimeapps.list", HOME / ".local/share/applications/mimeapps.list")
HANDLER_LINE = re.compile(r"^x-scheme-handler/astroarc=astro-arc-save-theme-handler\.desktop;?\s*$")

# The old row holds a button and a status span and no nested <div>, so the first
# </div> after it is its own.
SAVE_ROW = re.compile(r'<div class="save-theme-row">.*?</div>', re.S)
SAVE_NOTE = ('<p style="font-size:12.5px;opacity:.75;margin:4px 0 0">To keep this theme, or share it, '
             'open Astro-Arc in the bar and choose it under Themes Generated.</p>')

done = []


def say(message):
    done.append(message)


def run(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=20).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


# ---- 1. the systemd timer ---------------------------------------------------

def remove_timer():
    present = [SYSTEMD_DIR / u for u in UNITS if (SYSTEMD_DIR / u).exists() or (SYSTEMD_DIR / u).is_symlink()]
    wants = SYSTEMD_DIR / "timers.target.wants" / UNITS[0]
    if not present and not wants.is_symlink():
        return
    # Only ever units this project wrote: its service runs astro-arc-generate.
    service = SYSTEMD_DIR / UNITS[1]
    if service.is_file() and "astro-arc-generate" not in service.read_text(errors="replace"):
        return
    if shutil.which("systemctl"):
        run("systemctl", "--user", "disable", "--now", UNITS[0])
    for path in present:
        path.unlink(missing_ok=True)
    if wants.is_symlink():
        wants.unlink()
    if shutil.which("systemctl"):
        run("systemctl", "--user", "daemon-reload")
    say("removed the old systemd timer; the panel schedules generations itself")


# ---- 2. the astroarc:// handler ----------------------------------------------

def remove_handler():
    removed = False
    if HANDLER.exists():
        HANDLER.unlink()
        removed = True
    for mimeapps in MIMEAPPS:
        if not mimeapps.is_file():
            continue
        lines = mimeapps.read_text(errors="replace").splitlines(keepends=True)
        kept = [line for line in lines if not HANDLER_LINE.match(line)]
        if len(kept) != len(lines):
            mimeapps.write_text("".join(kept))
            removed = True
    if removed:
        if shutil.which("update-desktop-database"):
            run("update-desktop-database", str(HANDLER.parent))
        say("removed the astroarc:// link handler")


# ---- 3. the archive -----------------------------------------------------------

def _from_page(page_html, pattern):
    match = re.search(pattern, page_html, re.S)
    return html.unescape(match.group(1)).strip() if match else ""


def _thumbnail(entry_dir, page_html):
    """From the theme snapshot's wallpaper when there is one; otherwise from the
    image the old page carries inline."""
    image = entry_dir / "theme/backgrounds/background.png"
    temp = None
    if not image.is_file():
        match = re.search(r'src="data:image/png;base64,([A-Za-z0-9+/=]+)"', page_html)
        if not match:
            return None
        temp = entry_dir / ".thumb-source.png"
        temp.write_bytes(base64.b64decode(match.group(1)))
        image = temp
    try:
        thumbnail_jpeg(image, entry_dir / "thumb.jpg", 640, quality=82)
        return "thumb.jpg"
    except ImageError:
        return None
    finally:
        if temp:
            temp.unlink(missing_ok=True)


def move_archive():
    if not LEGACY_REVIEWS_DIR.is_dir():
        return
    legacy_index_file = LEGACY_REVIEWS_DIR / "index.json"
    try:
        legacy = json.loads(legacy_index_file.read_text()) if legacy_index_file.exists() else []
    except (json.JSONDecodeError, OSError):
        legacy = []
    try:
        current = json.loads(GENERATIONS_INDEX.read_text()) if GENERATIONS_INDEX.exists() else []
    except (json.JSONDecodeError, OSError):
        current = []
    known = {e.get("id") for e in current}

    GENERATIONS_DIR.mkdir(parents=True, exist_ok=True)
    moved = 0
    for entry in legacy:
        gen_id = entry.get("id")
        if not gen_id or gen_id in known:
            continue
        src, dst = LEGACY_REVIEWS_DIR / gen_id, GENERATIONS_DIR / gen_id
        if src.is_dir() and not dst.exists():
            shutil.move(str(src), str(dst))
        if not dst.is_dir():
            continue  # its folder was already gone; an index row alone is not worth keeping
        page = dst / "index.html"
        page_html = page.read_text(errors="replace") if page.is_file() else ""
        if 'class="save-theme-row"' in page_html:
            page_html = SAVE_ROW.sub(SAVE_NOTE, page_html, count=1)
            page.write_text(page_html)
        entry = dict(entry)
        entry["path"] = str(page)
        entry["thumb"] = _thumbnail(dst, page_html)
        entry.setdefault("distillation", _from_page(page_html, r'class="distillation">&ldquo;(.*?)&rdquo;'))
        entry.setdefault("narrativePosition", _from_page(page_html, r'<span class="badge">(.*?)</span>'))
        current.append(entry)
        moved += 1

    current.sort(key=lambda e: e.get("createdAt", ""), reverse=True)
    ARCHIVE_DIR.mkdir(parents=True, exist_ok=True)
    GENERATIONS_INDEX.write_text(json.dumps(current, indent=2))

    # Whatever is left — the old index, backups of it, folders it never listed —
    # is kept, not deleted, in one clearly named place.
    leftovers = [p for p in LEGACY_REVIEWS_DIR.iterdir()]
    if leftovers:
        keep = ARCHIVE_DIR / "from-state-reviews"
        keep.mkdir(exist_ok=True)
        for path in leftovers:
            target, n = keep / path.name, 1
            while target.exists():  # never overwrite, never strand: keep both
                target, n = keep / f"{path.name}.{n}", n + 1
            shutil.move(str(path), str(target))
    try:
        LEGACY_REVIEWS_DIR.rmdir()
    except OSError:
        pass
    archive_gallery.write_gallery()
    if moved:
        say(f"moved {moved} generation{'s' if moved != 1 else ''} to {ARCHIVE_DIR}")
    else:
        say(f"finished moving the archive to {ARCHIVE_DIR}")


def remove_old_wallpaper_copies():
    """Background-only mode briefly kept its wallpaper copy in state; it now
    points at the archive. Remove the copies unless one is still on screen."""
    old = STATE_DIR / "wallpaper"
    if not old.is_dir():
        return
    link = HOME / ".local/state/omarchy/current/background"
    try:
        showing = link.resolve().is_relative_to(old.resolve())
    except OSError:
        showing = False
    if not showing:
        shutil.rmtree(old, ignore_errors=True)


def main():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with open(STATE_DIR / "migrate.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)  # the panel and a generation can both start this at once
        remove_timer()
        remove_handler()
        move_archive()
        remove_old_wallpaper_copies()
    for message in done:
        print(f"Astro-Arc: {message}", file=sys.stderr)


if __name__ == "__main__":
    main()
