#!/bin/bash

# Puts one "Themes Generated" entry's theme snapshot
# (generations/<id>/theme/, written by build_review.py) back on the desktop:
# copies it into astro-arc's live theme folder and switches Omarchy to it.
#
# Usage: astro-arc-set-theme <review-id>
#
# This is the "I liked Tuesday's better" button. Distinct from its two
# neighbours in the panel, which both make a *copy* and leave the desktop
# alone:
#   astro-arc-save-theme    -> a new, permanent theme under ~/.config/omarchy/themes/
#   astro-arc-export-theme  -> a shareable package of one
# This one changes what you are looking at, and changes nothing permanent:
# the live astro-arc theme is regenerated by the next run either way, so
# the snapshot in the archive stays the only lasting copy.
#
# The live theme folder is cleared the same way astro-arc-generate clears it
# (everything except backgrounds/), for the same reason: whichever generator
# produced the current theme may have left files this snapshot doesn't have,
# and omarchy-theme-set-templates only writes a config the theme lacks, so a
# stale file would quietly survive and be used.

set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=astro-arc-paths.sh
source "$BIN_DIR/astro-arc-paths.sh"
INDEX_FILE="$GENERATIONS_INDEX"
THEME_DIR="$HOME/.config/omarchy/themes/astro-arc"

review_id="${1:-}"
if [[ -z $review_id ]]; then
  echo "Usage: astro-arc-set-theme <review-id>" >&2
  exit 1
fi

[[ -f $INDEX_FILE ]] || { echo "astro-arc-set-theme: no generations.json in the archive yet" >&2; exit 1; }

review_path=$(jq -r --arg id "$review_id" '.[] | select(.id == $id) | .path' "$INDEX_FILE")
if [[ -z $review_path ]]; then
  echo "astro-arc-set-theme: no generation with id '$review_id'" >&2
  exit 1
fi

theme_snapshot_dir="$(dirname "$review_path")/theme"
if [[ ! -f $theme_snapshot_dir/colors.toml ]]; then
  echo "astro-arc-set-theme: '$review_id' has no theme snapshot (generated before this feature existed)" >&2
  exit 1
fi

command -v omarchy-theme-set >/dev/null 2>&1 \
  || { echo "astro-arc-set-theme: omarchy-theme-set is not on PATH" >&2; exit 1; }

mkdir -p "$THEME_DIR/backgrounds"
find "$THEME_DIR" -mindepth 1 -maxdepth 1 ! -name backgrounds -exec rm -rf {} +
cp -r "$theme_snapshot_dir/." "$THEME_DIR/"

# The snapshot carries its own background, so the wallpaper follows the
# colours rather than staying on whatever the last run set.
if [[ -f $theme_snapshot_dir/backgrounds/background.png ]]; then
  cp -f "$theme_snapshot_dir/backgrounds/background.png" "$THEME_DIR/backgrounds/background.png"
fi

omarchy-theme-set astro-arc >/dev/null 2>&1 \
  || { echo "astro-arc-set-theme: omarchy-theme-set failed" >&2; exit 1; }

# The label the panel shows back, not the id: the id is machine-facing.
jq -r --arg id "$review_id" '.[] | select(.id == $id) | .label // $id' "$INDEX_FILE"
