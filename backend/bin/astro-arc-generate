#!/bin/bash

# Orchestrates one full Astro-Arc generation cycle:
#   astro_engine.py -> llm_pipeline.py (Stage 1 interpret, Stage 2 image
#     prompt) -> (image_gen.py | openai_image_gen.py) -> theming (aether, or
#     palette_extract.py as its default/fallback) -> Omarchy theme ->
#     omarchy-theme-set -> build_review.py (logs it + snapshots the theme
#     dir for astro-arc-save-theme) -> astro-arc-prune-history (deletes
#     entries past config.historyRetentionDays, default 30)
#
# llm_pipeline.py replaced the old lookup-table symbol_map.py: both its
# stages are themselves OpenAI chat calls, so an API key is required now
# regardless of which backend below actually renders the image — the
# local/free choice only applies to the image render, not the prompt.
#
# Backend is whichever the widget's settings picked (config.imageBackend):
# "local" (free, the pinned sd-turbo checkpoint) or "openai" (the widget's
# model/quality picker) — either way needs a key stored via astro-arc-apikey.
#
# Theme generator is config.themeGenerator: "built-in" (palette_extract.py,
# default, no external dependency) or "aether" (Omarchy's own theme
# generator, richer output, falls back to built-in automatically on any
# failure — see the theming block below for exactly what that excludes/why).
#
# --if-due: skip the whole run (exit 0) if the current period already has a
# generation — used by the systemd user timer (astro-arc-generate.timer)
# and the bar widget's own polling Timer (Panel.qml's checkAutoGenerate),
# so either scheduler can fire on a plain interval without needing its own
# copy of the "is this actually due" logic, and without risking a wasted
# paid image render on a period that's already generated. Plain manual runs
# (the widget's Regenerate button) never pass this — a manual click always
# means "regenerate right now", period match or not.
if_due=0
if [[ "${1:-}" == "--if-due" ]]; then
  if_due=1
  shift
fi

set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_PY="$HOME/.local/share/omarchy/astro-arc/venv/bin/python3"
CONFIG_FILE="$HOME/.local/state/omarchy/settings/astro-arc.json"
STATE_DIR="$HOME/.local/state/omarchy/astro-arc"
HISTORY_DIR="$STATE_DIR/history"
LAST_RUN_FILE="$STATE_DIR/last-run.json"
THEME_DIR="$HOME/.config/omarchy/themes/astro-arc"
PIPELINE_STATE_DIR="$STATE_DIR/pipeline"
COSTS_FILE="$PIPELINE_STATE_DIR/costs.json"
COSTS_MAX=200
LOCK_FILE="$STATE_DIR/generate.lock"

mkdir -p "$STATE_DIR" "$HISTORY_DIR" "$THEME_DIR/backgrounds" "$PIPELINE_STATE_DIR"

# Two independent schedulers (the systemd timer and the widget's own poll)
# plus a possible manual click all shell out to this same script — this
# non-blocking lock is what keeps two of them from ever rendering (and
# paying for) two images at once. Whichever loses just skips this run
# entirely rather than queuing: it'll get the next tick a few minutes
# later, and by then the winner will have already made it not-due anyway.
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  echo "Astro-Arc: another generation is already running — skipping" >&2
  exit 0
fi

frequency=$(jq -r '.frequency // "daily"' "$CONFIG_FILE" 2>/dev/null || echo "daily")
image_backend=$(jq -r '.imageBackend // "local"' "$CONFIG_FILE" 2>/dev/null || echo "local")
openai_model=$(jq -r '.openaiModel // "gpt-image-1-mini"' "$CONFIG_FILE" 2>/dev/null || echo "gpt-image-1-mini")
openai_quality=$(jq -r '.openaiQuality // "medium"' "$CONFIG_FILE" 2>/dev/null || echo "medium")
background_size=$(jq -r '.backgroundSize // "auto"' "$CONFIG_FILE" 2>/dev/null || echo "auto")

case "$frequency" in
  weekly) period_key=$(date +%G-W%V) ;;
  monthly) period_key=$(date +%Y-%m) ;;
  *) frequency="daily"; period_key=$(date +%Y-%m-%d) ;;
esac

if [[ $if_due == 1 ]]; then
  last_period_key=$(jq -r '.periodKey // empty' "$LAST_RUN_FILE" 2>/dev/null || true)
  if [[ -n $last_period_key && $last_period_key == "$period_key" ]]; then
    echo "Astro-Arc: $frequency period $period_key already generated — nothing to do"
    exit 0
  fi
fi

# "auto" resolves fresh every run, so a monitor change (new laptop screen,
# a plugged-in external display) is picked up next generation with no
# setting to remember to update.
if [[ $background_size == auto ]]; then
  background_size=$("$BIN_DIR/astro-arc-detect-resolution" 2>/dev/null || echo "1920x1080")
fi
bg_width=${background_size%x*}
bg_height=${background_size#*x}

reading_file="$STATE_DIR/reading-$period_key.json"
bg_file="$HISTORY_DIR/$period_key.png"
pipeline_meta_file="$STATE_DIR/pipeline-meta-$period_key.json"
image_cost_file="$STATE_DIR/image-cost-$period_key.json"

"$VENV_PY" "$BIN_DIR/astro_engine.py" >"$reading_file"
if jq -e '.error' "$reading_file" >/dev/null 2>&1; then
  echo "Astro-Arc: $(jq -r '.error' "$reading_file")" >&2
  exit 1
fi

prompt=$("$VENV_PY" "$BIN_DIR/llm_pipeline.py" "$reading_file" "$pipeline_meta_file")

# Bump to "high" quality whenever Stage 2 actually put a person in the
# image — medium-quality gpt-image-1-mini renders visibly distort faces/
# hands in busy or even single-figure scenes (confirmed via a same-prompt
# medium-vs-high comparison), and there's no anatomy to distort in a
# people-free object/place image, so this only spends more on the
# generations that actually need it. No-op for gpt-image-2 (always
# renders at its own "auto" quality regardless of this flag) and for the
# local backend (image_gen.py has no quality tiers, only --steps).
openai_quality_used="$openai_quality"
if [[ $(jq -r '.hasPeople // false' "$pipeline_meta_file" 2>/dev/null) == true ]]; then
  openai_quality_used="high"
fi

if [[ $image_backend == openai ]]; then
  "$VENV_PY" "$BIN_DIR/openai_image_gen.py" "$prompt" "$bg_file" \
    --model "$openai_model" --quality "$openai_quality_used" \
    --width "$bg_width" --height "$bg_height" --cost-out "$image_cost_file"
else
  "$VENV_PY" "$BIN_DIR/image_gen.py" "$prompt" "$bg_file" --steps 8 \
    --width "$bg_width" --height "$bg_height" --cost-out "$image_cost_file"
fi

# Clean slate every run, not just an overwrite: whichever theme generator
# ran last time (built-in or aether) may have left files the other one
# doesn't produce (e.g. aether's mako.ini, or a stale alacritty.toml that
# would otherwise permanently block a fresh one — omarchy-theme-set-
# templates only generates a config if the theme doesn't already have one).
# THEME_DIR only ever holds generator output plus backgrounds/, so this is
# always safe to clear.
find "$THEME_DIR" -mindepth 1 -maxdepth 1 ! -name backgrounds -exec rm -rf {} +
mkdir -p "$THEME_DIR/backgrounds"
cp -f "$bg_file" "$THEME_DIR/backgrounds/background.png"

theme_generator=$(jq -r '.themeGenerator // "built-in"' "$CONFIG_FILE" 2>/dev/null || echo "built-in")

# Theming: derive colors.toml + icons.theme from the rendered image.
# icons.theme is the file GNOME/Nautilus's icon color actually comes from
# (see palette_extract.py's comment) — without it, omarchy-theme-set-gnome
# silently falls back to a hardcoded "Yaru-blue" forever, which is why the
# file manager never looked like it was re-theming.
#
# "aether" shells out to Omarchy's own richer theme generator (also
# produces icons.theme, plus Zed/VS Code/terminal/mako/waybar configs the
# built-in extractor doesn't). Any failure — aether missing, non-zero
# exit, no colors.toml produced — logs a warning and falls straight
# through to the built-in extractor below, so a broken or absent aether
# install never blocks a generation.
used_aether=0
if [[ $theme_generator == aether ]]; then
  if command -v aether >/dev/null 2>&1; then
    aether_scratch=$(mktemp -d)
    if aether --generate "$bg_file" --no-apply --output "$aether_scratch" >/dev/null 2>&1 \
      && [[ -f $aether_scratch/colors.toml ]]; then
      # Copy everything aether produced except:
      #   backgrounds/       — astro-arc already placed the one background
      #                        file above; a second file here would make
      #                        omarchy-theme-set's background picker cycle
      #                        between two instead of always using the latest.
      #   vscode.json / vscode-extension/ — names a "local.theme-aether" VS
      #                        Code extension that --no-apply never actually
      #                        installs, which would leave VS Code pointed at
      #                        a theme that doesn't exist. Renaming aether's
      #                        own generated theme JSON to vscode-theme.json
      #                        instead lets omarchy-theme-set-vscode's
      #                        existing self-installing fallback handle it —
      #                        same schema Omarchy's own template output uses.
      find "$aether_scratch" -mindepth 1 -maxdepth 1 \
        ! -name backgrounds ! -name vscode.json ! -name vscode-extension \
        -exec cp -rf {} "$THEME_DIR/" \;
      if [[ -f $aether_scratch/vscode-extension/themes/aether-color-theme.json ]]; then
        cp -f "$aether_scratch/vscode-extension/themes/aether-color-theme.json" "$THEME_DIR/vscode-theme.json"
      fi
      used_aether=1
    else
      echo "Astro-Arc: aether theme generation failed — falling back to built-in" >&2
    fi
    rm -rf "$aether_scratch"
  else
    echo "Astro-Arc: theme generator set to aether, but aether is not installed — falling back to built-in" >&2
  fi
fi

if [[ $used_aether == 0 ]]; then
  "$VENV_PY" "$BIN_DIR/palette_extract.py" "$bg_file" "$THEME_DIR/colors.toml"
fi

omarchy-theme-set astro-arc >/dev/null 2>&1

# Cost log: real token-based cost for the two chat calls (from
# llm_pipeline.py's metadata) plus the image call (from the backend's
# --cost-out) — the full cost of all 3 API calls for this generation, per
# the widget's usage counter. Any field can be null: cached calls (no cost
# incurred) and unrecognized models (cost_estimate.py won't guess) both
# report null rather than a fabricated number.
generated_at="$(date -Iseconds)"
stage1_cost=$(jq -r '.stage1Cost // "null"' "$pipeline_meta_file")
stage2_cost=$(jq -r '.stage2Cost // "null"' "$pipeline_meta_file")
signature_cost=$(jq -r '.signatureCost // "null"' "$pipeline_meta_file")
image_cost=$(jq -r '.cost // "null"' "$image_cost_file" 2>/dev/null || echo "null")
image_cost_source=$(jq -r '.costSource // "unknown"' "$image_cost_file" 2>/dev/null || echo "unknown")

cost_entry=$(jq -n \
  --arg timestamp "$generated_at" --arg periodKey "$period_key" --arg frequency "$frequency" \
  --arg backend "$image_backend" --arg imageCostSource "$image_cost_source" \
  --argjson stage1Cost "$stage1_cost" --argjson stage2Cost "$stage2_cost" \
  --argjson signatureCost "$signature_cost" --argjson imageCost "$image_cost" \
  '{
    timestamp: $timestamp, periodKey: $periodKey, frequency: $frequency, imageBackend: $backend,
    stage1Cost: $stage1Cost, stage2Cost: $stage2Cost, signatureCost: $signatureCost,
    imageCost: $imageCost, imageCostSource: $imageCostSource,
    totalCost: ([$stage1Cost, $stage2Cost, $signatureCost, $imageCost] | map(select(. != null)) | add)
  }')

if [[ -f $COSTS_FILE ]]; then
  jq --argjson entry "$cost_entry" '[$entry] + . | .[0:'"$COSTS_MAX"']' "$COSTS_FILE" >"$COSTS_FILE.tmp" && mv "$COSTS_FILE.tmp" "$COSTS_FILE"
else
  jq -n --argjson entry "$cost_entry" '[$entry]' >"$COSTS_FILE"
fi

# last-run.json carries the Stage 1 reading + Stage 2 metadata alongside
# the usual run info — so the user can see *why* an image came out the way
# it did, and it's what the review log pulls from to caption past runs.
theme_generator_used=$([[ $used_aether == 1 ]] && echo "aether" || echo "built-in")
jq -n --arg periodKey "$period_key" --arg generatedAt "$generated_at" --arg frequency "$frequency" \
  --arg backend "$image_backend" --arg prompt "$prompt" --arg backgroundSize "$background_size" \
  --arg themeGenerator "$theme_generator" --arg themeGeneratorUsed "$theme_generator_used" \
  --arg imageQuality "$openai_quality" --arg imageQualityUsed "$openai_quality_used" \
  --slurpfile meta "$pipeline_meta_file" --argjson cost "$cost_entry" \
  '{periodKey: $periodKey, generatedAt: $generatedAt, frequency: $frequency, imageBackend: $backend, prompt: $prompt, backgroundSize: $backgroundSize, themeGenerator: $themeGenerator, themeGeneratorUsed: $themeGeneratorUsed, imageQuality: $imageQuality, imageQualityUsed: $imageQualityUsed, cost: $cost} * $meta[0]' >"$LAST_RUN_FILE"

# Log this as a browsable "Themes Generated" iteration — every real run,
# not just manual style-comparison batches, so reverting to an earlier
# reading/prompt/register later on means finding it in this list rather
# than trying to remember it. Also snapshots the live theme dir (--theme-dir)
# so astro-arc-save-theme has a complete standalone theme to export later,
# and records --period-key so pruning can find the matching history/*.png.
# build_review.py prints the review's index.html path on success —
# captured (not discarded) so the notification below can open it.
review_label="${frequency^} · $(date '+%b %-d, %-I:%M %p') ($image_backend)"
review_path=""
if review_path=$("$VENV_PY" "$BIN_DIR/build_review.py" \
  --reading "$reading_file" --meta "$pipeline_meta_file" --image "$bg_file" \
  --label "$review_label" --cost-json "$cost_entry" \
  --theme-dir "$THEME_DIR" --period-key "$period_key"); then
  :
else
  echo "Astro-Arc: warning — could not log this iteration to the review history" >&2
  review_path=""
fi

# Prune "Themes Generated" entries (and their matching history/*.png) past
# the configured retention window — every run self-maintains, no separate
# cron needed. Never touches a theme astro-arc-save-theme exported; that's
# a permanent copy outside this whole system. Best-effort: a failure here
# must never fail the generation that already succeeded.
history_retention_days=$(jq -r '.historyRetentionDays // 30' "$CONFIG_FILE" 2>/dev/null || echo 30)
"$BIN_DIR/astro-arc-prune-history" --older-than-days "$history_retention_days" >/dev/null 2>&1 \
  || echo "Astro-Arc: warning — history pruning failed" >&2

# Surface the distillation — the one-line psychological core of this run's
# reading, same text the widget shows under its narrative-position badge
# (see Panel.qml/Model.js parseLastRun) and the review page shows under its
# "Threshold"-style badge — as a toast, so a real generation is noticed
# even when the panel isn't open. Click opens the full review; the toast
# itself expires after 15s regardless (omarchy-notification-send -t is
# milliseconds). Never let a notification failure fail the generation.
distillation=$(jq -r '.distillation // empty' "$pipeline_meta_file" 2>/dev/null)
if [[ -n $distillation ]] && command -v omarchy-notification-send >/dev/null 2>&1; then
  notify_args=(
    --app-name astro-arc -g "✦" -u normal -t 15000
    "$distillation" "Click for deeper insight"
  )
  if [[ -n $review_path ]]; then
    notify_args+=(--exec xdg-open "$review_path")
  fi
  omarchy-notification-send "${notify_args[@]}" \
    || echo "Astro-Arc: warning — could not send the generation notification" >&2
fi

echo "Astro-Arc: generated $frequency theme for period $period_key via $image_backend at $background_size"
