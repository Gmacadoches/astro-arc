#!/bin/bash

# Orchestrates one full Astro-Arc generation cycle:
#   astro_engine.py -> llm_pipeline.py (Stage 1 interpret, Stage 2 image
#     prompt) -> openai_image_gen.py -> theming (aether, or
#     palette_extract.py as its default/fallback) -> Omarchy theme ->
#     omarchy-theme-set -> build_review.py (logs it + snapshots the theme
#     dir for astro-arc-save-theme) -> astro-arc-prune-history (deletes
#     entries past config.historyRetentionDays, default 30)
#
# llm_pipeline.py replaced the old lookup-table symbol_map.py: both its
# stages are themselves OpenAI chat calls, so an API key is required now
# regardless of which backend below actually renders the image — the
# local/free choice only applies to the image render, not the prompt.
#
# Backend is whichever the widget's settings picked (config.imageBackend):
# "local" (free, the pinned sd-turbo checkpoint) or "openai" (the widget's
# model/quality picker) — either way needs a key stored via astro-arc-apikey.
#
# Theme generator is config.themeGenerator: "built-in" (palette_extract.py,
# default, no external dependency) or "aether" (Omarchy's own theme
# generator, richer output, falls back to built-in automatically on any
# failure — see the theming block below for exactly what that excludes/why).
#
# --if-due: skip the whole run (exit 0) if the current period already has a
# generation — used by the systemd user timer (astro-arc-generate.timer)
# and the bar widget's own polling Timer (Panel.qml's checkAutoGenerate),
# so either scheduler can fire on a plain interval without needing its own
# copy of the "is this actually due" logic, and without risking a wasted
# paid image render on a period that's already generated. Plain manual runs
# (the widget's Regenerate button) never pass this — a manual click always
# means "regenerate right now", period match or not.
if_due=0
if [[ "${1:-}" == "--if-due" ]]; then
  if_due=1
  shift
fi

set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_PY="$HOME/.local/share/omarchy/astro-arc/venv/bin/python3"
CONFIG_FILE="$HOME/.local/state/omarchy/settings/astro-arc.json"
STATE_DIR="$HOME/.local/state/omarchy/astro-arc"
HISTORY_DIR="$STATE_DIR/history"
LAST_RUN_FILE="$STATE_DIR/last-run.json"
THEME_DIR="$HOME/.config/omarchy/themes/astro-arc"
PIPELINE_STATE_DIR="$STATE_DIR/pipeline"
COSTS_FILE="$PIPELINE_STATE_DIR/costs.json"
COSTS_MAX=200
LOCK_FILE="$STATE_DIR/generate.lock"

mkdir -p "$STATE_DIR" "$HISTORY_DIR" "$THEME_DIR/backgrounds" "$PIPELINE_STATE_DIR"

# Two independent schedulers (the systemd timer and the widget's own poll)
# plus a possible manual click all shell out to this same script — this
# non-blocking lock is what keeps two of them from ever rendering (and
# paying for) two images at once. Whichever loses just skips this run
# entirely rather than queuing: it'll get the next tick a few minutes
# later, and by then the winner will have already made it not-due anyway.
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  echo "Astro-Arc: another generation is already running — skipping" >&2
  exit 0
fi

# One read, through astro-arc-config, so the defaults live in exactly one place.
# Reading $CONFIG_FILE directly meant every value here carried a second copy of
# a default, and the frequency copy had already drifted from DEFAULTS.
config_json=$("$BIN_DIR/astro-arc-config" 2>/dev/null || echo '{}')
cfg() { jq -r "$1" <<<"$config_json" 2>/dev/null; }

frequency=$(cfg '.frequency // "manual"')
# `provider` is the global setting now (see astro-arc-config --set-provider);
# `imageBackend` is the legacy key it supersedes. OpenAI is the only renderer:
# the local Stable Diffusion path (image_gen.py) was removed on 2026-09-19,
# because it needed torch in a Python venv, and the plugin no longer installs
# anything. A config still naming "local" is refused below with a clear message
# rather than silently rendered somewhere the user did not choose.
image_backend=$(cfg '.provider // .imageBackend // "openai"')
# `// "default"` is NOT enough on these two. jq's // only substitutes for null
# and false, and astro-arc-config DEFAULTS both of them to the empty string —
# so on a config where the image model has never been picked, `//` passed ""
# through and the render failed with an unhelpful API error instead of falling
# back. Test the value, don't just test for null.
openai_model=$(cfg '(.openaiModel // "") | if . == "" then "gpt-image-1-mini" else . end')
openai_quality=$(cfg '(.openaiQuality // "") | if . == "" then "medium" else . end')
background_size=$(cfg '.backgroundSize // "auto"')

# Delegates to period_key.py, which is the single definition of what a period
# key is — see that file's header for why it stopped being four hand-synced
# copies. It imports nothing but datetime, so plain system python3 runs it
# without this project's venv.
period_key_for() {
  local freq="$1" when="${2:-}"
  if [[ -n $when ]]; then
    python3 "$BIN_DIR/period_key.py" "$freq" "$when" 2>/dev/null || true
  else
    python3 "$BIN_DIR/period_key.py" "$freq" 2>/dev/null || true
  fi
}

case "$frequency" in
  hourly|weekly|monthly|manual) ;;
  *) frequency="daily" ;;
esac
period_key=$(period_key_for "$frequency")
# Every reading, image, cache and review entry is named after this. An empty
# key would quietly write files called "reading-.json" and compare due-ness
# against nothing, so refuse to run rather than corrupt the state directory.
[[ -n $period_key ]] || {
  echo "astro-arc-generate: could not compute a period key (is python3 on PATH?)" >&2
  exit 1
}

# Scheduled invocations (--if-due, i.e. the systemd timer and the widget's poll)
# do nothing at all on "manual". A deliberate Regenerate click does not pass
# --if-due, so the button keeps working — which is the entire point of the
# setting: no surprise spending, generate when you ask.
if [[ $if_due == 1 && $frequency == manual ]]; then
  echo "Astro-Arc: auto-generation is off (frequency is \"manual\") — nothing to do"
  exit 0
fi

if [[ $if_due == 1 ]]; then
  # Re-key the last run's TIMESTAMP under the frequency in effect right now,
  # rather than trusting the key it was filed under — that key was written
  # under whatever frequency was set at the time. Comparing it directly meant
  # that switching Daily -> Monthly put "2026-09-13" up against "2026-09", saw
  # two different strings, and started a paid render as the immediate
  # consequence of touching a dropdown. Re-keyed, a run from Sep 13 is plainly
  # inside the September that Monthly is now asking about, and nothing runs.
  # Falls back to the stored key for a last-run.json too old to carry
  # generatedAt, or carrying one `date` can't parse.
  last_generated_at=$(jq -r '.generatedAt // empty' "$LAST_RUN_FILE" 2>/dev/null || true)
  last_period_key=$(jq -r '.periodKey // empty' "$LAST_RUN_FILE" 2>/dev/null || true)
  last_covered_key=""
  if [[ -n $last_generated_at ]]; then
    last_covered_key=$(period_key_for "$frequency" "$last_generated_at" 2>/dev/null || true)
  fi
  [[ -n $last_covered_key ]] || last_covered_key="$last_period_key"
  if [[ -n $last_covered_key && $last_covered_key == "$period_key" ]]; then
    echo "Astro-Arc: $frequency period $period_key already generated — nothing to do"
    exit 0
  fi
fi

if [[ $image_backend != openai ]]; then
  echo "astro-arc-generate: the image provider is set to \"$image_backend\", but only OpenAI is supported." >&2
  echo "  Choose OpenAI under Settings → Provider in the Astro-Arc widget." >&2
  exit 1
fi

# Checked here rather than earlier so the --if-due no-ops above (nothing due,
# or auto-generation off) stay quiet on an install that has not been set up.
if [[ ! -x $VENV_PY ]]; then
  echo "astro-arc-generate: no Python venv at $VENV_PY" >&2
  echo "  Create it by running the installer, which builds it from the hash-checked" >&2
  echo "  lock in backend/requirements.lock:" >&2
  echo "    \"$BIN_DIR/../../install.sh\"" >&2
  exit 1
fi

# "auto" resolves fresh every run, so a monitor change (new laptop screen,
# a plugged-in external display) is picked up next generation with no
# setting to remember to update.
if [[ $background_size == auto ]]; then
  background_size=$("$BIN_DIR/astro-arc-detect-resolution" 2>/dev/null || echo "1920x1080")
fi
bg_width=${background_size%x*}
bg_height=${background_size#*x}

reading_file="$STATE_DIR/reading-$period_key.json"
bg_file="$HISTORY_DIR/$period_key.png"
pipeline_meta_file="$STATE_DIR/pipeline-meta-$period_key.json"
image_cost_file="$STATE_DIR/image-cost-$period_key.json"

# A location saved before the config carried a timezone has coordinates but no
# zone. Ask Open-Meteo for it once, from those coordinates — the same service
# the location picker geocodes with — and store it, so this never runs again.
# Failure is not fatal here: the engine refuses clearly on a missing zone.
if [[ -z $(cfg '.timezone // ""') && -n $(cfg '.latitude // ""') && -n $(cfg '.longitude // ""') ]]; then
  lookup_tz=$(curl -fsS --max-time 10 \
    "https://api.open-meteo.com/v1/forecast?latitude=$(cfg '.latitude')&longitude=$(cfg '.longitude')&timezone=auto&forecast_days=1" \
    2>/dev/null | jq -r '.timezone // empty' 2>/dev/null || true)
  if [[ -n $lookup_tz ]] && "$BIN_DIR/astro-arc-config" --set-timezone "$lookup_tz" >/dev/null; then
    echo "Astro-Arc: stored the birth place's timezone ($lookup_tz)" >&2
  fi
fi

# The engine reports its own failures as {"error": "..."} on STDOUT, and stdout
# here goes straight into the reading file — so a fresh install with no birth
# data yet produced exit 1, an empty terminal, a reading file containing the
# error object, and (because the widget shows stderr) a Regenerate button that
# looked like it did nothing. Capture, surface, and do not write a broken file.
if ! reading_json=$("$VENV_PY" "$BIN_DIR/astro_engine.py" 2>&1); then
  engine_error=$(jq -r '.error // empty' <<<"$reading_json" 2>/dev/null || true)
  echo "astro-arc-generate: ${engine_error:-the chart engine failed}" >&2
  [[ -n $engine_error ]] || echo "$reading_json" >&2
  exit 1
fi
printf '%s' "$reading_json" >"$reading_file"
if jq -e '.error' "$reading_file" >/dev/null 2>&1; then
  echo "Astro-Arc: $(jq -r '.error' "$reading_file")" >&2
  exit 1
fi

# The engine is the authority on the period key, and it is also what Stage 1 /
# Stage 1.5 cache under (llm_pipeline.py reads reading.arc.periodKey). This script
# computes the same key independently above with `date`, so the two must agree.
#
# They used not to: the engine keyed on the UTC date while this script keyed on the
# local date, so after ~18:00 local an evening run wrote its reading into
# *tomorrow's* cache slot and the next day's run was served yesterday evening's
# astrology. That really happened — pipeline-meta-2026-09-10.json and
# -2026-09-11.json still hold a byte-identical reading, amplification and
# intrusion, and the only difference between those two days' images was the
# register/style roulette. The engine now keys on local civil date too
# (derive_arc's docstring has the full story), so both sides agree by construction.
#
# This guard catches the one remaining way they can diverge: the clock crossing
# midnight between the `date` call above and the engine's own. Warn rather than
# fail — the generation is still valid, it just belongs to the other day.
# The engine keys the READING, which is not always keyed the way this script
# keys its files: on an hourly schedule the engine has no hourly arc, so it
# deliberately keys by date while this script keys by hour. Comparing against
# period_key directly made every single hourly run print a drift warning about
# a difference that is the design. Compare against the cache key instead, which
# is where that rule lives — so this stays a real check for the thing it was
# written for: the clock crossing a period boundary mid-run.
expected_engine_key=$(python3 "$BIN_DIR/period_key.py" --cache "$frequency" 2>/dev/null || true)
engine_period_key=$(jq -r '.arc.periodKey // empty' "$reading_file" 2>/dev/null || true)
if [[ -n $engine_period_key && -n $expected_engine_key && $engine_period_key != "$expected_engine_key" ]]; then
  echo "Astro-Arc: period key drift — the engine says $engine_period_key, expected $expected_engine_key (clock crossed a period boundary mid-run). Cache and filenames will disagree for this run." >&2
fi

prompt=$("$VENV_PY" "$BIN_DIR/llm_pipeline.py" "$reading_file" "$pipeline_meta_file")

# Quality is whatever the config says, for every image. There used to be a bump
# to "high" whenever Stage 2 put a person in frame, on evidence from a
# 2026-09-07 medium-vs-high comparison on gpt-image-1-mini, wrapped in a cost
# ceiling to stop it running away. It was removed 2026-09-13 because the
# evidence had reversed: the image bakeoff found gpt-image-2.5-sunburst at
# "low" MORE prompt-faithful than the same model at "high" (which merged two
# objects into one) for 7x the price, and the people renders that prompted the
# bump look excellent at the configured tier. Paying 7x for a worse image on
# the strength of a measurement taken against a different model is not a
# trade worth keeping, and the ceiling machinery only existed to contain it.
#
# `imageQualityUsed` survives in the metadata below, identical to `imageQuality`
# now, because build_review.py reads it and every archived run carries it.

"$VENV_PY" "$BIN_DIR/openai_image_gen.py" "$prompt" "$bg_file" \
  --model "$openai_model" --quality "$openai_quality" \
  --width "$bg_width" --height "$bg_height" --cost-out "$image_cost_file"

# Clean slate every run, not just an overwrite: whichever theme generator
# ran last time (built-in or aether) may have left files the other one
# doesn't produce (e.g. aether's mako.ini, or a stale alacritty.toml that
# would otherwise permanently block a fresh one — omarchy-theme-set-
# templates only generates a config if the theme doesn't already have one).
# THEME_DIR only ever holds generator output plus backgrounds/, so this is
# always safe to clear.
find "$THEME_DIR" -mindepth 1 -maxdepth 1 ! -name backgrounds -exec rm -rf {} +
mkdir -p "$THEME_DIR/backgrounds"
cp -f "$bg_file" "$THEME_DIR/backgrounds/background.png"

theme_generator=$(cfg '.themeGenerator // "built-in"')

# Theming: derive colors.toml + icons.theme from the rendered image.
# icons.theme is the file GNOME/Nautilus's icon color actually comes from
# (see palette_extract.py's comment) — without it, omarchy-theme-set-gnome
# silently falls back to a hardcoded "Yaru-blue" forever, which is why the
# file manager never looked like it was re-theming.
#
# "aether" shells out to Omarchy's own richer theme generator (also
# produces icons.theme, plus Zed/VS Code/terminal/mako/waybar configs the
# built-in extractor doesn't). Any failure — aether missing, non-zero
# exit, no colors.toml produced — logs a warning and falls straight
# through to the built-in extractor below, so a broken or absent aether
# install never blocks a generation.
used_aether=0
if [[ $theme_generator == aether ]]; then
  if command -v aether >/dev/null 2>&1; then
    aether_scratch=$(mktemp -d)
    if aether --generate "$bg_file" --no-apply --output "$aether_scratch" >/dev/null 2>&1 \
      && [[ -f $aether_scratch/colors.toml ]]; then
      # Copy everything aether produced except:
      #   backgrounds/       — astro-arc already placed the one background
      #                        file above; a second file here would make
      #                        omarchy-theme-set's background picker cycle
      #                        between two instead of always using the latest.
      #   vscode.json / vscode-extension/ — names a "local.theme-aether" VS
      #                        Code extension that --no-apply never actually
      #                        installs, which would leave VS Code pointed at
      #                        a theme that doesn't exist. Renaming aether's
      #                        own generated theme JSON to vscode-theme.json
      #                        instead lets omarchy-theme-set-vscode's
      #                        existing self-installing fallback handle it —
      #                        same schema Omarchy's own template output uses.
      find "$aether_scratch" -mindepth 1 -maxdepth 1 \
        ! -name backgrounds ! -name vscode.json ! -name vscode-extension \
        -exec cp -rf {} "$THEME_DIR/" \;
      if [[ -f $aether_scratch/vscode-extension/themes/aether-color-theme.json ]]; then
        cp -f "$aether_scratch/vscode-extension/themes/aether-color-theme.json" "$THEME_DIR/vscode-theme.json"
      fi
      used_aether=1
    else
      echo "Astro-Arc: aether theme generation failed — falling back to built-in" >&2
    fi
    rm -rf "$aether_scratch"
  else
    echo "Astro-Arc: theme generator set to aether, but aether is not installed — falling back to built-in" >&2
  fi
fi

if [[ $used_aether == 0 ]]; then
  "$VENV_PY" "$BIN_DIR/palette_extract.py" "$bg_file" "$THEME_DIR/colors.toml"
fi

# backgroundOnly (default true): change the wallpaper and leave the user's own
# theme — its colors and every app it themes — exactly as it was. The palette
# above is still derived, because the review page's theme snapshot and Save
# Selected Theme are built from it; it is just not applied.
#
# NOT `.backgroundOnly // true`: jq's // treats false as missing, so that would
# turn an explicit "off" back into "on". Only a literal false turns it off.
#
# The wallpaper is copied to its own per-run filename rather than pointed at
# history/<period>.png, for two reasons: history files are pruned on the
# retention window and overwritten by a same-period rerun, and the shell's
# background can miss a change of content at an unchanged path.
background_only=$(cfg 'if .backgroundOnly == false then "false" else "true" end')
if [[ $background_only == true ]]; then
  wallpaper_dir="$STATE_DIR/wallpaper"
  mkdir -p "$wallpaper_dir"
  wallpaper="$wallpaper_dir/astro-arc-$(date +%Y%m%d-%H%M%S).png"
  cp -f "$bg_file" "$wallpaper"
  find "$wallpaper_dir" -maxdepth 1 -name 'astro-arc-*.png' ! -path "$wallpaper" -delete
  omarchy-theme-bg-set "$wallpaper" >/dev/null 2>&1 \
    || echo "Astro-Arc: warning — could not set the background" >&2
else
  omarchy-theme-set astro-arc >/dev/null 2>&1
fi

# Cost log: real token-based cost for the two chat calls (from
# llm_pipeline.py's metadata) plus the image call (from the backend's
# --cost-out) — the full cost of all 3 API calls for this generation, per
# the widget's usage counter. Any field can be null: cached calls (no cost
# incurred) and unrecognized models (cost_estimate.py won't guess) both
# report null rather than a fabricated number.
generated_at="$(date -Iseconds)"
stage1_cost=$(jq -r '.stage1Cost // "null"' "$pipeline_meta_file")
stage15_cost=$(jq -r '.stage15Cost // "null"' "$pipeline_meta_file")
stage2_cost=$(jq -r '.stage2Cost // "null"' "$pipeline_meta_file")
signature_cost=$(jq -r '.signatureCost // "null"' "$pipeline_meta_file")
image_cost=$(jq -r '.cost // "null"' "$image_cost_file" 2>/dev/null || echo "null")
image_cost_source=$(jq -r '.costSource // "unknown"' "$image_cost_file" 2>/dev/null || echo "unknown")

cost_entry=$(jq -n \
  --arg timestamp "$generated_at" --arg periodKey "$period_key" --arg frequency "$frequency" \
  --arg backend "$image_backend" --arg imageCostSource "$image_cost_source" \
  --arg imageModel "$openai_model" --arg imageQualityUsed "$openai_quality" \
  --argjson stage1Cost "$stage1_cost" --argjson stage15Cost "$stage15_cost" \
  --argjson stage2Cost "$stage2_cost" \
  --argjson signatureCost "$signature_cost" --argjson imageCost "$image_cost" \
  '{
    timestamp: $timestamp, periodKey: $periodKey, frequency: $frequency, imageBackend: $backend,
    stage1Cost: $stage1Cost, stage15Cost: $stage15Cost, stage2Cost: $stage2Cost, signatureCost: $signatureCost,
    imageCost: $imageCost, imageCostSource: $imageCostSource,
    imageModel: $imageModel, imageQualityUsed: $imageQualityUsed,
    totalCost: ([$stage1Cost, $stage15Cost, $stage2Cost, $signatureCost, $imageCost] | map(select(. != null)) | add)
  }')

if [[ -f $COSTS_FILE ]]; then
  jq --argjson entry "$cost_entry" '[$entry] + . | .[0:'"$COSTS_MAX"']' "$COSTS_FILE" >"$COSTS_FILE.tmp" && mv "$COSTS_FILE.tmp" "$COSTS_FILE"
else
  jq -n --argjson entry "$cost_entry" '[$entry]' >"$COSTS_FILE"
fi

# last-run.json carries the Stage 1 reading + Stage 2 metadata alongside
# the usual run info — so the user can see *why* an image came out the way
# it did, and it's what the review log pulls from to caption past runs.
theme_generator_used=$([[ $used_aether == 1 ]] && echo "aether" || echo "built-in")
jq -n --arg periodKey "$period_key" --arg generatedAt "$generated_at" --arg frequency "$frequency" \
  --arg backend "$image_backend" --arg prompt "$prompt" --arg backgroundSize "$background_size" \
  --arg themeGenerator "$theme_generator" --arg themeGeneratorUsed "$theme_generator_used" \
  --arg imageQuality "$openai_quality" --arg imageQualityUsed "$openai_quality" \
  --arg imageModel "$openai_model" \
  --slurpfile meta "$pipeline_meta_file" --argjson cost "$cost_entry" \
  '{periodKey: $periodKey, generatedAt: $generatedAt, frequency: $frequency, imageBackend: $backend, prompt: $prompt, backgroundSize: $backgroundSize, themeGenerator: $themeGenerator, themeGeneratorUsed: $themeGeneratorUsed, imageQuality: $imageQuality, imageQualityUsed: $imageQualityUsed, imageModel: $imageModel, cost: $cost} * $meta[0]' >"$LAST_RUN_FILE"

# Log this as a browsable "Themes Generated" iteration — every real run,
# not just manual style-comparison batches, so reverting to an earlier
# reading/prompt/register later on means finding it in this list rather
# than trying to remember it. Also snapshots the live theme dir (--theme-dir)
# so astro-arc-save-theme has a complete standalone theme to export later,
# and records --period-key so pruning can find the matching history/*.png.
# build_review.py prints the review's index.html path on success —
# captured (not discarded) so the notification below can open it.
# Title format: date, time, style — "Sep 13, 10:03 AM · Antique Engraving".
# Cadence and image backend used to lead and trail this ("Daily · … (openai)")
# and were dropped: every entry in the list carried the same two values, so
# they distinguished nothing while crowding out the one field that actually
# varies between entries generated on the same day — the style.
review_style_label=$(jq -r '.artStyleLabel // .artStyle // empty' "$pipeline_meta_file" 2>/dev/null || true)
review_label="$(date '+%b %-d, %-I:%M %p')${review_style_label:+ · $review_style_label}"
review_path=""
if review_path=$("$VENV_PY" "$BIN_DIR/build_review.py" \
  --reading "$reading_file" --meta "$pipeline_meta_file" --image "$bg_file" \
  --label "$review_label" --cost-json "$cost_entry" \
  --theme-dir "$THEME_DIR" --period-key "$period_key"); then
  :
else
  echo "Astro-Arc: warning — could not log this iteration to the review history" >&2
  review_path=""
fi

# Prune "Themes Generated" entries (and their matching history/*.png) past
# the configured retention window — every run self-maintains, no separate
# cron needed. Never touches a theme astro-arc-save-theme exported; that's
# a permanent copy outside this whole system. Best-effort: a failure here
# must never fail the generation that already succeeded.
history_retention_days=$(cfg '.historyRetentionDays // 30')
"$BIN_DIR/astro-arc-prune-history" --older-than-days "$history_retention_days" >/dev/null 2>&1 \
  || echo "Astro-Arc: warning — history pruning failed" >&2

# Surface the distillation — the one-line psychological core of this run's
# reading, same text the widget shows under its narrative-position badge
# (see Panel.qml/Model.js parseLastRun) and the review page shows under its
# "Threshold"-style badge — as a toast, so a real generation is noticed
# even when the panel isn't open. Click opens the full review; the toast
# itself expires after 15s regardless (omarchy-notification-send -t is
# milliseconds). Never let a notification failure fail the generation.
distillation=$(jq -r '.distillation // empty' "$pipeline_meta_file" 2>/dev/null)
if [[ -n $distillation ]] && command -v omarchy-notification-send >/dev/null 2>&1; then
  notify_args=(
    --app-name astro-arc -g "✦" -u normal -t 15000
    "$distillation" "Click for deeper insight"
  )
  if [[ -n $review_path ]]; then
    notify_args+=(--exec xdg-open "$review_path")
  fi
  omarchy-notification-send "${notify_args[@]}" \
    || echo "Astro-Arc: warning — could not send the generation notification" >&2
fi

echo "Astro-Arc: generated $frequency theme for period $period_key via $image_backend at $background_size"
