#!/bin/bash

# Handles astroarc://save-theme?id=<review-id>&name=<url-encoded-name>
# links — clicked from a "Themes Generated" review page's own Save Theme
# button (build_review.py). Registered as the x-scheme-handler/astroarc
# URI handler via astro-arc-save-theme-handler.desktop.tpl, installed by
# install.sh (a browser can't run a shell script directly; a registered
# custom URI scheme is how a static, server-less HTML page still triggers
# one — the same mechanism Aether's own aether:// links use on this
# system, see /usr/share/applications/li.oever.aether.url-handler.desktop).
#
# Runs astro-arc-save-theme and reports the result as a desktop
# notification, since a URI handler launched by the browser has no
# terminal or window of its own to show output in — omarchy-notification-
# send is the only way back to the user here.
#
# Usage: astro-arc-save-theme-handler <astroarc://save-theme?id=...&name=...>

set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

notify() {
  local urgency="$1" headline="$2" body="$3"
  command -v omarchy-notification-send >/dev/null 2>&1 || return 0
  omarchy-notification-send --app-name astro-arc -u "$urgency" -t 8000 "$headline" "$body" >/dev/null 2>&1 || true
}

urldecode() {
  local data="${1//+/ }"
  printf '%b' "${data//%/\\x}"
}

uri="${1:-}"
if [[ -z $uri ]]; then
  notify critical "Save Theme failed" "No link was passed to the handler."
  exit 1
fi

query="${uri#*\?}"
review_id=""
theme_name=""
IFS='&' read -ra pairs <<<"$query"
for pair in "${pairs[@]}"; do
  key="${pair%%=*}"
  value="${pair#*=}"
  case "$key" in
    id) review_id=$(urldecode "$value") ;;
    name) theme_name=$(urldecode "$value") ;;
  esac
done

if [[ -z $review_id ]]; then
  notify critical "Save Theme failed" "The link didn't include a review id."
  exit 1
fi

if result=$("$BIN_DIR/astro-arc-save-theme" "$review_id" "$theme_name" 2>&1); then
  notify normal "Theme saved" "Saved as \"$result\" — pick it from Omarchy's own theme switcher any time."
else
  notify critical "Save Theme failed" "$result"
  exit 1
fi
