#!/bin/bash

# Pre-publish safety check: fails the build if anything that looks like a
# hardcoded API key is found in any script this plugin ships. Run this
# before ever committing/publishing the plugin repo.
#
# Usage: astro-arc-check-secrets [dir ...]
#   Defaults to the QML plugin directory and the backend bin/ directory.

set -euo pipefail

DIRS=("$@")
if [[ ${#DIRS[@]} -eq 0 ]]; then
  DIRS=(
    "$HOME/.config/omarchy/plugins/astro-arc"
    "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  )
fi

# OpenAI-style keys (sk-...), generic long hex/base64-ish secrets assigned
# to something key-shaped, and any literal `Authorization: Bearer <token>`
# with a real-looking token rather than a variable/interpolation.
PATTERNS=(
  'sk-[a-zA-Z0-9_-]{20,}'
  '(api[_-]?key|apikey|secret|token)["\x27]?\s*[:=]\s*["\x27][a-zA-Z0-9_\-]{16,}["\x27]'
)

found=0
for dir in "${DIRS[@]}"; do
  [[ -d $dir ]] || continue
  for pattern in "${PATTERNS[@]}"; do
    matches=$(grep -rEn --exclude-dir=.git --exclude-dir=venv --exclude-dir=models "$pattern" "$dir" || true)
    if [[ -n $matches ]]; then
      echo "Possible hardcoded secret found:" >&2
      echo "$matches" >&2
      found=1
    fi
  done
done

if [[ $found -eq 1 ]]; then
  echo "astro-arc-check-secrets: FAILED — do not publish until the above is resolved." >&2
  exit 1
fi

echo "astro-arc-check-secrets: no hardcoded secrets found in ${DIRS[*]}"
