#!/bin/bash

# Exports one "Themes Generated" entry's theme snapshot
# (reviews/<id>/theme/, written by build_review.py) into a new, permanent
# Omarchy theme under ~/.config/omarchy/themes/ — so it becomes its own
# selectable theme via Omarchy's own theme picker/omarchy-theme-set,
# completely independent of astro-arc's live theme (which gets wiped and
# regenerated every run) and of the N-day history retention window that
# prunes old "Themes Generated" entries. This is the only way a specific
# generation survives both.
#
# Usage: astro-arc-save-theme <review-id> [theme-name]
#   theme-name (optional): the widget prompts for one, pre-filled with a
#   suggestion built from that review's concept tags — see Model.js's
#   suggestThemeName. Sanitized the same way omarchy-theme-set itself
#   normalizes a theme name (lowercase, spaces -> dashes); falls back to
#   the old auto-name (astro-arc-saved-<review-id>) if omitted or if
#   sanitizing leaves nothing usable.
#   Prints the new theme's name on success (nothing else to stdout), so a
#   caller (Panel.qml) can show it back to the user.

set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=astro-arc-paths.sh
source "$BIN_DIR/astro-arc-paths.sh"
INDEX_FILE="$GENERATIONS_INDEX"
THEMES_DIR="$HOME/.config/omarchy/themes"

review_id="${1:-}"
requested_name="${2:-}"
if [[ -z $review_id ]]; then
  echo "Usage: astro-arc-save-theme <review-id> [theme-name]" >&2
  exit 1
fi

[[ -f $INDEX_FILE ]] || { echo "astro-arc-save-theme: no generations.json in the archive yet" >&2; exit 1; }

review_path=$(jq -r --arg id "$review_id" '.[] | select(.id == $id) | .path' "$INDEX_FILE")
if [[ -z $review_path ]]; then
  echo "astro-arc-save-theme: no review with id '$review_id'" >&2
  exit 1
fi

theme_snapshot_dir="$(dirname "$review_path")/theme"
if [[ ! -f $theme_snapshot_dir/colors.toml ]]; then
  echo "astro-arc-save-theme: '$review_id' has no theme snapshot to save (generated before this feature existed)" >&2
  exit 1
fi

if [[ -n $requested_name ]]; then
  theme_name=$(tr '[:upper:]' '[:lower:]' <<<"$requested_name" | tr ' ' '-' | sed -E 's/[^a-z0-9-]//g; s/-+/-/g; s/^-+//; s/-+$//')
  if [[ -z $theme_name || $theme_name == .* ]]; then
    echo "astro-arc-save-theme: '$requested_name' isn't a usable theme name — try letters, numbers, spaces, or dashes" >&2
    exit 1
  fi
else
  # review_id is already unique (timestamp + hash suffix from
  # build_review.py), so it doubles as a collision-free, sortable name.
  theme_name="astro-arc-saved-$review_id"
fi
target_dir="$THEMES_DIR/$theme_name"

if [[ -e $target_dir ]]; then
  echo "astro-arc-save-theme: a theme named '$theme_name' already exists — pick a different name" >&2
  exit 1
fi

mkdir -p "$target_dir"
cp -r "$theme_snapshot_dir/." "$target_dir/"

echo "$theme_name"
